@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<h1>Change Password</h1>
@if (ViewBag.Message != null) { <p class="success">@ViewBag.Message</p> }
<form asp-action="ChangePassword" method="post" class="form-grid">
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <label>Current Password</label><input asp-for="CurrentPassword" />
    <label>New Password</label><input asp-for="NewPassword" />
    <label>Confirm Password</label><input asp-for="ConfirmPassword" />
    <button>Change Password</button>
</form>
