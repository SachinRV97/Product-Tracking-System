@model IEnumerable<AppUser>
@{ ViewData["Title"] = "Users"; }
<h1>User Management</h1><p><a class="button" asp-action="Create">Create User</a></p>
<table><thead><tr><th>User</th><th>Employee</th><th>Code</th><th>Department</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.UserName</td><td>@item.EmployeeName</td><td>@item.EmployeeCode</td><td>@item.Department?.Name</td><td>@item.Role?.Name</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td></tr> }
</tbody></table>
